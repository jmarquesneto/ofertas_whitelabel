# ---------- Pastas no OMV (caminho ABSOLUTO, sem barra no fim) ----------
# Ex.: /srv/dev-disk-by-uuid-1234-abcd/appdata/vitrine
# Dentro dela serão usadas as subpastas postgres/ e uploads/
# Use um disco ext4/btrfs (o Postgres não funciona bem em NTFS, SMB ou mergerfs)
APPDATA_PATH=/srv/dev-disk-by-uuid-XXXX/appdata/vitrine

# Usuário/grupo que roda o app e fica dono de uploads/ (no OMV: rode "id SEU_USUARIO").
# O container ajusta as permissões da pasta sozinho ao iniciar.
PUID=1000
PGID=100

# ---------- Banco ----------
POSTGRES_USER=vitrine
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=vitrine

# ---------- Aplicação ----------
# Gere com: openssl rand -base64 48
# Assina as sessões e cifra os segredos do 2FA. NÃO troque depois de criar usuários
# (os segredos do Authenticator ficariam ilegíveis e seria preciso reconfigurar o 2FA).
APP_SECRET=cole-aqui-uma-string-aleatoria-com-mais-de-32-caracteres

# Domínio público (sem barra no fim) — usado na pré-visualização do link curto
PUBLIC_URL=https://ofertas.seudominio.com.br

DEFAULT_SITE_NAME=Minha Vitrine
TOTP_ISSUER=Minha Vitrine Admin

# false = só o PRIMEIRO usuário pode se cadastrar sozinho (recomendado)
ALLOW_REGISTRATION=false

OFFER_DEFAULT_HOURS=72
UPLOAD_MAX_MB=8

# true em produção com HTTPS. Use false apenas para testar via http://IP:PORTA
COOKIE_SECURE=true

TZ=America/Bahia
# Porta no host. Se estiver ocupada, troque só este número (ex.: 3081, 8095)
APP_PORT=3080

# ---------- Só para desenvolvimento local (npm run dev) ----------
# DATABASE_URL=postgres://vitrine:senha@localhost:5432/vitrine
# UPLOAD_DIR=./uploads
